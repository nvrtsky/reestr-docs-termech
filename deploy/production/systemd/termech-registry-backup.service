[Unit]
Description=Back up the Termech document registry PostgreSQL database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/reestr-docs
Environment=REGISTRY_BACKUP_RETENTION_DAYS=14
ExecStart=/opt/reestr-docs/deploy/production/scripts/backup-registry.sh
UMask=0077
