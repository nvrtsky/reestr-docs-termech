POSTGRES_DB=registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=replace-with-a-long-random-password

FRONTEND_HOST_PORT=3202
BACKEND_HOST_PORT=3203

PUBLIC_BASE_URL=https://reestr.navrotsky.ru
WEB_ORIGIN=https://reestr.navrotsky.ru
BITRIX_APP_PATH=/
VITE_APP_BASE_URL=/
VITE_BITRIX_APP_CODE=replace-with-marketplace-app-code

# Keep the first client explicitly allowlisted. Marketplace mode additionally
# accepts official Bitrix24 cloud domains only after an installation is stored.
BITRIX_ALLOWED_DOMAINS=thermech.bitrix24.ru
BITRIX_MARKETPLACE_MODE=true
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_APP_CODE=
TOKEN_ENCRYPTION_KEY=
BITRIX_OAUTH_URL=https://oauth.bitrix.info/oauth/token/
DATA_RETENTION_DAYS=30
SUPPORT_EMAIL=alexandr@navrotsky.ru
BITRIX_REQUEST_TIMEOUT_MS=10000
BITRIX_UPLOAD_TIMEOUT_MS=600000
PORTAL_TIME_ZONE=Europe/Minsk

# Set after binding Bitrix24 events. Do not commit the real value.
BITRIX_EVENT_APPLICATION_TOKEN=
